{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOFV",
  "version": "0.1.1",
  "identifier": "dev.tofv",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "TOFV",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "preventOverflow": true,
        "visible": false,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/512x512.png"
    ]
  }
}
